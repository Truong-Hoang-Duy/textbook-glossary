{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glossary/schema.json",
  "title": "Glossary của một bộ {mon}_{lop}",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "terms"],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "terms": {
      "type": "array",
      "items": { "$ref": "#/$defs/term" }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "subject", "subject_name", "grade", "last_updated", "term_count"],
      "properties": {
        "unit": { "type": "string", "pattern": "^[a-z]+(_[a-z]+)*_[0-9]+$" },
        "subject": { "type": "string", "pattern": "^[a-z]+(_[a-z]+)*$" },
        "subject_name": { "type": "string", "minLength": 1 },
        "grade": { "type": "integer", "minimum": 1, "maximum": 12 },
        "last_updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "term_count": { "type": "integer", "minimum": 0 }
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "term", "aliases", "type", "definition", "notation", "chapter", "lesson", "level", "related_terms", "sources", "notes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "term": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "type": {
          "enum": ["dinh_nghia", "dinh_ly", "tinh_chat", "cong_thuc", "ky_hieu", "quy_tac"]
        },
        "definition": { "type": "string", "minLength": 1 },
        "notation": { "type": ["string", "null"], "minLength": 1 },
        "chapter": { "type": "string", "minLength": 1 },
        "lesson": { "type": "string", "minLength": 1 },
        "level": { "enum": ["co_ban", "chuyen_de"] },
        "related_terms": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "notes": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["book_type", "file", "pdf_page", "printed_page"],
      "properties": {
        "book_type": { "enum": ["sgk", "scd", "gv", "sbt"] },
        "file": { "type": "string", "pattern": "\\.pdf$" },
        "pdf_page": { "type": "integer", "minimum": 1 },
        "printed_page": { "type": ["integer", "null"], "minimum": 1 }
      }
    }
  }
}
