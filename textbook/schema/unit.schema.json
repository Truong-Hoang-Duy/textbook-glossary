{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "textbook/schema/unit.schema.json",
  "title": "Dữ liệu một bộ {mon}_{lop}, xuất từ Tầng 1 và Tầng 2",
  "description": "Do export_unit.py sinh ra ở textbook/dataset/<unit>.json, không sửa tay. Mục lục là cây đệ quy theo đúng sách (giống progress.json); từ điển theo mẫu _Huong-dan (bảng 4 cột, quy ước, ghi chú nguồn).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "source",
    "toc",
    "dictionaries",
    "terms",
    "source_notes"
  ],
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "toc": {
      "description": "Cây mục lục theo đúng thứ tự in, sâu 1–3 cấp (Phần/Chương/Chủ đề/Tập/Unit → Bài/Lesson…).",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "dictionaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dictionary"
      }
    },
    "terms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/term"
      }
    },
    "source_notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_note"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "lesson_id": {
      "description": "Mã nút trong cây mục lục (spec mục 3.2), duy nhất trong bộ: b01, u01-l1, mo-dau…",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "page_range": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ],
      "items": false,
      "minItems": 2
    },
    "status": {
      "enum": [
        "draft",
        "verified"
      ]
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "unit",
        "subject",
        "subject_name",
        "grade",
        "generated_at",
        "counts"
      ],
      "properties": {
        "schema_version": {
          "const": "2.1"
        },
        "unit": {
          "type": "string",
          "pattern": "^[a-z]+(_[a-z]+)*_(10|11|12)$"
        },
        "subject": {
          "type": "string",
          "pattern": "^[a-z]+(_[a-z]+)*$"
        },
        "subject_name": {
          "type": "string",
          "minLength": 1
        },
        "grade": {
          "enum": [
            10,
            11,
            12
          ]
        },
        "generated_at": {
          "$ref": "#/$defs/date"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lessons",
            "terms",
            "terms_out_of_source",
            "open_notes"
          ],
          "properties": {
            "lessons": {
              "type": "integer",
              "minimum": 0
            },
            "terms": {
              "type": "integer",
              "minimum": 0
            },
            "terms_out_of_source": {
              "type": "integer",
              "minimum": 0
            },
            "open_notes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "source": {
      "description": "Sách nguồn. Hiện chỉ SGK; SGK nhiều tập thì mỗi tập một file.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "book_type",
        "series",
        "publisher",
        "files"
      ],
      "properties": {
        "book_type": {
          "enum": [
            "sgk"
          ]
        },
        "series": {
          "const": "Kết nối tri thức với cuộc sống"
        },
        "publisher": {
          "const": "NXB Giáo dục Việt Nam"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "volume",
              "page_count",
              "printed_offset"
            ],
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^SGK .+\\.pdf$"
              },
              "volume": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "page_count": {
                "type": "integer",
                "minimum": 1
              },
              "printed_offset": {
                "description": "trang in = trang PDF − printed_offset (giá trị mặc định của file).",
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "kind",
        "label",
        "number",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/lesson_id"
        },
        "role": {
          "enum": [
            "group",
            "lesson",
            "front_matter",
            "back_matter"
          ]
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z]+(_[a-z]+)*$",
          "description": "Loại nút chuẩn hoá (spec mục 3.2)."
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Tiền tố in trên sách: \"Phần bốn\", \"Chủ đề 1\", \"Bài 3\", \"Unit 2\"; null nếu không có."
        },
        "number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Tên in trên sách, không gồm tiền tố."
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "lesson_type": {
          "enum": [
            "ly_thuyet",
            "thuc_hanh",
            "du_an",
            "on_tap"
          ]
        },
        "file": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\.md$",
          "description": "Đường dẫn file Tầng 1, tính từ thư mục bộ; null nếu trang đầu/cuối sách không chép."
        },
        "source_file": {
          "type": "string",
          "pattern": "\\.pdf$"
        },
        "pdf_pages": {
          "$ref": "#/$defs/page_range"
        },
        "printed_pages": {
          "$ref": "#/$defs/page_range"
        },
        "status": {
          "enum": [
            "pending",
            "layer1",
            "layer2",
            "verified",
            "skip"
          ]
        },
        "objectives": {
          "description": "Khung yêu cầu cần đạt ở đầu bài, nguyên văn; null nếu SGK không có khung.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "items",
                "pdf_page"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "pdf_page": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        },
        "key_terms": {
          "description": "Cột \"THUẬT NGỮ\" đầu bài (chỉ môn Toán); môn khác để [].",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "figures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/figure"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "group"
              }
            }
          },
          "then": {
            "required": [
              "children"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "file"
                  ]
                },
                {
                  "required": [
                    "pdf_pages"
                  ]
                },
                {
                  "required": [
                    "objectives"
                  ]
                },
                {
                  "required": [
                    "figures"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "file",
              "source_file",
              "pdf_pages",
              "printed_pages",
              "status"
            ],
            "not": {
              "required": [
                "children"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "lesson"
              }
            }
          },
          "then": {
            "required": [
              "lesson_type",
              "objectives",
              "key_terms",
              "figures"
            ],
            "properties": {
              "file": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "caption",
        "pdf_page"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^H(10|11|12)-[a-z_]+-[a-z0-9]+(-[a-z0-9]+)*-[0-9]{2}$",
          "description": "H<lop>-<mon>-<id bài>-<stt>, ví dụ H12-sinh-b01-01."
        },
        "file": {
          "type": "string",
          "pattern": "\\.png$"
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "description": "Chú thích nguyên văn của sách."
        },
        "pdf_page": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "dictionary": {
      "description": "Một file từ điển Tầng 2 (theo mẫu _Huong-dan/Từ điển <Môn> <lớp>.md).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "name",
        "title",
        "group_id",
        "lesson_ids",
        "conventions",
        "status",
        "created",
        "updated"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^Tu-dien-.+\\.md$"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "group_id": {
          "$ref": "#/$defs/lesson_id",
          "description": "id của nút group mà từ điển phủ (Chương/Chủ đề/Unit…)."
        },
        "lesson_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/lesson_id"
          }
        },
        "conventions": {
          "description": "Các gạch đầu dòng của mục \"Quy ước sử dụng\", nguyên văn.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "created": {
          "$ref": "#/$defs/date"
        },
        "updated": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "term": {
      "description": "Một dòng của bảng 4 cột trong từ điển.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "term",
        "aliases",
        "english",
        "meaning",
        "usage_context",
        "scope",
        "source_status",
        "reference",
        "location",
        "dictionary",
        "note_ids"
      ],
      "properties": {
        "id": {
          "description": "<unit, _ đổi thành ->-<slug không dấu của tên chính>; trùng thì thêm -<lesson_id>.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "term": {
          "type": "string",
          "minLength": 1,
          "description": "Tên chính (cột Thuật ngữ, bỏ phần trong ngoặc)."
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Phần trong ngoặc của cột Thuật ngữ, ví dụ NST, NTBS, Ori."
        },
        "english": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Cột Tiếng Anh; null nếu để trống."
        },
        "meaning": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Cột Giải nghĩa; null khi source_status = out_of_source."
        },
        "usage_context": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Cột Bối cảnh sử dụng."
        },
        "scope": {
          "enum": [
            "shared",
            "lesson"
          ],
          "description": "shared: thuộc mục \"Thuật ngữ dùng chung\"; lesson: thuộc mục của một bài."
        },
        "source_status": {
          "enum": [
            "in_source",
            "out_of_source"
          ],
          "description": "out_of_source: dòng \"Ngoài nguồn\"."
        },
        "reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Phần \"Xem: …\" của dòng Ngoài nguồn; null nếu không có."
        },
        "location": {
          "description": "Chỗ in đậm thuật ngữ ở Tầng 1; null khi out_of_source.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lesson_id",
                "section",
                "pdf_page",
                "printed_page"
              ],
              "properties": {
                "lesson_id": {
                  "$ref": "#/$defs/lesson_id"
                },
                "section": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[IVX]+(\\.[0-9]+(\\.[a-z])?)?$",
                  "description": "Mục trong bài, ví dụ I, II.1, III.2.a; null nếu ở ngoài các mục La Mã."
                },
                "pdf_page": {
                  "type": "integer",
                  "minimum": 1
                },
                "printed_page": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        },
        "dictionary": {
          "type": "string",
          "pattern": "^Tu-dien-.+\\.md$"
        },
        "note_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "Các source_notes còn mở nhắc tới thuật ngữ này."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_status": {
                "const": "in_source"
              }
            }
          },
          "then": {
            "properties": {
              "meaning": {
                "type": "string"
              },
              "location": {
                "type": "object"
              },
              "reference": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "meaning": {
                "type": "null"
              },
              "location": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "source_note": {
      "description": "Một dòng của mục \"Ghi chú nguồn cần kiểm tra\".",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dictionary",
        "number",
        "status",
        "lesson_id",
        "section",
        "pdf_page",
        "term_ids",
        "issue",
        "resolution",
        "resolved_on"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+#[0-9]+$",
          "description": "<name của từ điển>#<số thứ tự>."
        },
        "dictionary": {
          "type": "string",
          "pattern": "^Tu-dien-.+\\.md$"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "open",
            "closed"
          ]
        },
        "lesson_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/lesson_id"
            }
          ]
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "pdf_page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "term_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "issue": {
          "type": "string",
          "minLength": 1
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "resolved_on": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/date"
            }
          ]
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "closed"
          }
        }
      },
      "then": {
        "properties": {
          "resolution": {
            "type": "string"
          },
          "resolved_on": {
            "$ref": "#/$defs/date"
          }
        }
      }
    }
  }
}
