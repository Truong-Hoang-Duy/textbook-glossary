{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "textbook/schema/progress.schema.json",
  "title": "progress.json của một bộ: cây mục lục chuẩn, dải trang, tiến độ",
  "description": "Nguồn sự thật cho mục lục và số trang. Mục lục là cây đệ quy theo đúng sách (Phần/Chương/Chủ đề/Tập/Unit → Bài/Lesson…), sâu 1–3 cấp. Tên chép đúng như in ở trang mở đầu, đọc từ ảnh.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit",
    "subject",
    "subject_name",
    "grade",
    "files",
    "toc",
    "notes",
    "audits",
    "last_session_note"
  ],
  "properties": {
    "unit": {
      "type": "string",
      "pattern": "^[a-z]+(_[a-z]+)*_(10|11|12)$"
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-z]+(_[a-z]+)*$"
    },
    "subject_name": {
      "type": "string",
      "minLength": 1
    },
    "grade": {
      "enum": [
        10,
        11,
        12
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "volume",
          "page_count",
          "printed_offset"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^SGK .+\\.pdf$"
          },
          "volume": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "page_count": {
            "type": "integer",
            "minimum": 1
          },
          "printed_offset": {
            "type": "integer",
            "description": "trang in = trang PDF − printed_offset"
          }
        }
      }
    },
    "toc": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "notes": {
      "description": "Điểm đặc thù của sách: chỗ mục lục khác trang mở đầu, cách ánh xạ heading riêng, phần cấu trúc lạ. Mỗi ý một chuỗi.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "audits": {
      "description": "Kết quả từng đợt kiểm tra mẫu (cổng 4), theo thứ tự thời gian.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/audit"
      }
    },
    "last_session_note": {
      "type": "string"
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "kind",
        "label",
        "number",
        "title"
      ],
      "properties": {
        "id": {
          "description": "Mã nút, duy nhất trong bộ (spec mục 3.2): mã loại + số 2 chữ số (c01, cd01, b01, u01) hoặc slug nếu không số; trùng thì nối mã nút cha phía trước (u01-l1).",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "role": {
          "description": "group: nhóm chứa nút con. lesson: bài có nội dung, có file Tầng 1. front_matter/back_matter: trang đầu/cuối sách (Lời nói đầu, Bảng tra cứu thuật ngữ…).",
          "enum": [
            "group",
            "lesson",
            "front_matter",
            "back_matter"
          ]
        },
        "kind": {
          "description": "Loại nút chuẩn hoá từ chữ in trên sách (spec mục 3.2): phan, chuong, chu_de, tap, unit, review, phuong_an, bai, lesson, mach_noi_dung, mo_dau, on_tap, loi_noi_dau, huong_dan, bang_tra_cuu…",
          "type": "string",
          "pattern": "^[a-z]+(_[a-z]+)*$"
        },
        "label": {
          "description": "Tiền tố in trên sách, giữ nguyên cách viết: \"Phần bốn\", \"Chương 1\", \"Chủ đề 3\", \"Bài 12\", \"Unit 2\", \"Review 1\". null nếu nút không có tiền tố.",
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Số thứ tự dạng số nguyên (\"bốn\" → 4, \"II\" → 2); null nếu không đánh số."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Tên in trên sách, không gồm tiền tố, ví dụ \"Di truyền học\"."
        },
        "dir": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+$",
          "description": "Chỉ nút group: tên thư mục Tầng 1."
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "lesson_type": {
          "enum": [
            "ly_thuyet",
            "thuc_hanh",
            "du_an",
            "on_tap"
          ]
        },
        "file": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9-]+\\.md$"
        },
        "source_file": {
          "type": "string",
          "pattern": "\\.pdf$"
        },
        "pdf_pages": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ],
          "items": false,
          "minItems": 2
        },
        "printed_offset": {
          "type": "integer",
          "description": "Chỉ ghi khi khác giá trị của file."
        },
        "status": {
          "enum": [
            "pending",
            "layer1",
            "layer2",
            "verified",
            "skip"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "group"
              }
            }
          },
          "then": {
            "required": [
              "dir",
              "children"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "file"
                  ]
                },
                {
                  "required": [
                    "pdf_pages"
                  ]
                },
                {
                  "required": [
                    "status"
                  ]
                },
                {
                  "required": [
                    "lesson_type"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "file",
              "source_file",
              "pdf_pages",
              "status"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "children"
                  ]
                },
                {
                  "required": [
                    "dir"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "lesson"
              }
            }
          },
          "then": {
            "required": [
              "lesson_type"
            ],
            "properties": {
              "file": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "scope",
        "terms",
        "sample",
        "errors",
        "fixed",
        "note"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "description": "id các nút trong toc được kiểm tra (ví dụ [\"c01\"])."
        },
        "terms": {
          "type": "integer",
          "minimum": 0,
          "description": "Tổng số thuật ngữ trong phạm vi."
        },
        "sample": {
          "type": "integer",
          "minimum": 1,
          "description": "Số mục lấy mẫu."
        },
        "errors": {
          "type": "integer",
          "minimum": 0,
          "description": "Số mục sai phát hiện."
        },
        "fixed": {
          "type": "integer",
          "minimum": 0,
          "description": "Số mục sai đã sửa."
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    }
  }
}
